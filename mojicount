import sys

text = sys.stdin.read()

chars = 0  # 空白を除く文字数
total = 0  # 改行を除く、すべての文字数
for c in text:
    if c == "\n" or c == "\r":
        continue
    total += 1
    if not c.isspace():
        chars += 1

lines = text.count("\n")
if text != "" and not text.endswith("\n"):
    lines += 1

sheets = (chars + 399) // 400

print(f"文字数（空白を除く）: {chars}")
print(f"総文字数（改行を除く）: {total}")
print(f"行数: {lines}")
print(f"原稿用紙（400字詰め）: {sheets} 枚")
